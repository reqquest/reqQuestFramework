{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "if": { "properties": { "type": { "const": "TC" } }, "required": ["type"] },
  "then": {
    "required": ["derives_from"],
    "properties": {
      "derives_from": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "pattern": "^(FR|NFR)-[A-Z0-9]{2,10}-[0-9]{3}$" },
        "uniqueItems": true
      }
    }
  }
}
