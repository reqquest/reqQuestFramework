{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "if": { "properties": { "type": { "const": "TC" } }, "required": ["type"] },
  "then": {
    "required": ["derives_from"],
    "properties": {
      "id": { "type": "string", "pattern": "^([A-Z]{2,6}-)?TC-[A-Z0-9]{2,10}-[0-9]{3}(?![\\s\\S])" },
      "derives_from": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "pattern": "^([A-Z]{2,6}-)?(FR|NFR)-[A-Z0-9]{2,10}-[0-9]{3}(@[0-9]+\\.[0-9]+)?(?![\\s\\S])" },
        "description": "Source FR/NFR IDs. `ID@major.minor` pins the source version this test was last reviewed against.",
        "uniqueItems": true
      }
    }
  }
}
