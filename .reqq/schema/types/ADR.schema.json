{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "if": { "properties": { "type": { "const": "ADR" } }, "required": ["type"] },
  "then": {
    "required": ["decisions"],
    "properties": {
      "decisions": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" }
      }
    }
  }
}
