{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "if": { "properties": { "type": { "const": "ADR" } }, "required": ["type"] },
  "then": {
    "required": ["decisions"],
    "properties": {
      "id": { "type": "string", "pattern": "^([A-Z]{2,6}-)?ADR-[A-Z0-9]{2,10}-[0-9]{3}(?![\\s\\S])" },
      "decisions": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" }
      }
    }
  }
}
