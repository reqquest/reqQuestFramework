{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "if": { "properties": { "type": { "const": "NFR" } }, "required": ["type"] },
  "then": {
    "required": ["category"],
    "properties": {
      "id": { "type": "string", "pattern": "^([A-Z]{2,6}-)?NFR-[A-Z0-9]{2,10}-[0-9]{3}(?![\\s\\S])" },
      "category": { "type": "string", "minLength": 2 }
    }
  }
}
