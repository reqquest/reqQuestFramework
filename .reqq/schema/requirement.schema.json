{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "reqQuest Framework Requirement Front Matter",
  "type": "object",
  "required": ["id", "title", "type", "status", "owner", "last_updated"],
  "properties": {
    "id": { "type": "string", "pattern": "^(BR|FR|NFR|ADR|TC|POL)-[A-Z0-9]{2,10}-[0-9]{3}$" },
    "type": { "type": "string", "enum": ["BR", "FR", "NFR", "ADR", "TC", "POL"] },
    "title": { "type": "string", "minLength": 5 },
    "owner": { "type": "string", "minLength": 2 },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "approved", "accepted", "deprecated"],
      "description": "`accepted` is a deprecated alias of `approved`; it will be removed in the next major version."
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "last_updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "traces_to": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(BR|FR|NFR|ADR|TC|POL)-[A-Z0-9]{2,10}-[0-9]{3}$" },
      "uniqueItems": true
    },
    "conflict": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["with", "resolution"],
        "properties": {
          "with": { "type": "string" },
          "resolution": { "type": "string", "enum": ["accepted", "rejected", "superseded"] },
          "rationale": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    { "$ref": "types/BR.schema.json#" },
    { "$ref": "types/FR.schema.json#" },
    { "$ref": "types/NFR.schema.json#" },
    { "$ref": "types/ADR.schema.json#" },
    { "$ref": "types/TC.schema.json#" },
    { "$ref": "types/POL.schema.json#" }
  ],
  "additionalProperties": true
}
