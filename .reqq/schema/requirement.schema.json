{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "reqQuest Framework Requirement Front Matter",
  "type": "object",
  "required": ["id", "title", "type", "status", "owner", "last_updated"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^([A-Z]{2,6}-)?(BR|FR|NFR|ADR|TC|POL)-[A-Z0-9]{2,10}-[0-9]{3}(?![\\s\\S])",
      "description": "`[PREFIX-]TYPE-CATEGORY-NNN`. The optional repository prefix (2–6 uppercase letters) is required by `id_prefix` in config.yaml."
    },
    "legacy_id": {
      "type": "string",
      "pattern": "^(BR|FR|NFR|ADR|TC|POL)-[A-Z0-9]{2,10}-[0-9]{3}(?![\\s\\S])",
      "description": "The last previous ID of this document, without a prefix, so history can be linked to the current ID."
    },
    "short_title": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+){0,3}(?![\\s\\S])",
      "description": "1–4 English words in lowercase, joined by hyphens, whatever `language` says. Not part of the ID. Required by `short_title: true` in config.yaml, which makes the file name `<id>-<short_title>.md`."
    },
    "type": { "type": "string", "enum": ["BR", "FR", "NFR", "ADR", "TC", "POL"] },
    "title": { "type": "string", "minLength": 5 },
    "owner": { "type": "string", "minLength": 2 },
    "status": { "type": "string", "enum": ["draft", "review", "approved", "deprecated"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?![\\s\\S])" },
    "last_updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(?![\\s\\S])" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "traces_to": {
      "type": "array",
      "items": { "type": "string", "pattern": "^([A-Z]{2,6}-)?(BR|FR|NFR|ADR|TC|POL)-[A-Z0-9]{2,10}-[0-9]{3}(@[0-9]+\\.[0-9]+)?(?![\\s\\S])" },
      "description": "Source IDs. `ID@major.minor` pins the source version this document was last reviewed against.",
      "uniqueItems": true
    },
    "conflict": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["with"],
        "properties": {
          "with": { "type": "string", "pattern": "^([A-Z]{2,6}-)?(BR|FR|NFR|ADR|TC|POL)-[A-Z0-9]{2,10}-[0-9]{3}(?![\\s\\S])" },
          "resolution": { "type": "string", "enum": ["accepted", "rejected", "superseded"] },
          "rationale": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    { "$ref": "types/BR.schema.json#" },
    { "$ref": "types/FR.schema.json#" },
    { "$ref": "types/NFR.schema.json#" },
    { "$ref": "types/ADR.schema.json#" },
    { "$ref": "types/TC.schema.json#" },
    { "$ref": "types/POL.schema.json#" },
    {
      "description": "Conflict lifecycle gate: an approved requirement has no unresolved `conflict` entry.",
      "if": { "properties": { "status": { "const": "approved" } }, "required": ["status"] },
      "then": { "properties": { "conflict": { "items": { "required": ["with", "resolution"] } } } }
    }
  ],
  "additionalProperties": true
}
